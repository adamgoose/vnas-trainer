{
  "name": "vnas-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run copy-static",
    "copy-static": "cp -R catalog dist/catalog",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "catalog": "bun run scripts/build-catalog.ts",
    "validate-catalog": "bun run scripts/validate-catalog.ts",
    "proxy": "bun run scripts/dev-proxy.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "foldkit": "0.158.0"
  },
  "devDependencies": {
    "@foldkit/devtools": "0.158.0",
    "@foldkit/ui": "0.158.0",
    "@foldkit/vite-plugin": "0.20.1",
    "@types/bun": "^1.3.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
